{
  "name": "@mini-dev/condition",
  "version": "0.1.1",
  "description": "小程序前置条件编排引擎 — 声明页面需要哪些条件，运行时自动判断、串行补齐并返回结果 | Prerequisite orchestration engine for mini-programs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "miniprogram": "dist/cjs/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "rimraf dist && tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "miniprogram",
    "小程序",
    "wechat",
    "微信小程序",
    "prerequisite",
    "condition",
    "ensure",
    "miniapp",
    "route-guard",
    "interceptor",
    "前置条件",
    "页面拦截"
  ],
  "author": "xesam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xesam/minidev-condition.git",
    "directory": "packages/condition"
  },
  "bugs": {
    "url": "https://github.com/xesam/minidev-condition/issues"
  },
  "homepage": "https://github.com/xesam/minidev-condition#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.9",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
