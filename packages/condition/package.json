{
  "name": "@mini-dev/condition",
  "version": "0.0.1",
  "description": "Prerequisite runtime for mini-program — declare what your page needs, runtime ensures it",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "miniprogram": "dist/cjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "rimraf dist && tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "miniprogram",
    "小程序",
    "prerequisite",
    "condition",
    "ensure",
    "miniapp"
  ],
  "author": "xesam",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.9",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
